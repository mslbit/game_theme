<?php
/**
 * Folix Game Theme - 评论列表模板
 *
 * 参考 topuplive.com 设计：
 * - 深色背景
 * - 用户邮箱（脱敏）+ 国旗图标
 * - 日期时间
 * - 评论内容
 * - 右侧显示星级评分
 *
 * @var ListView $block
 * @var SecureHtmlRenderer $secureRenderer
 * @var Escaper $escaper
 */

use Magento\Framework\Escaper;
use Magento\Framework\View\Helper\SecureHtmlRenderer;
use Magento\Review\Block\Product\View\ListView;

$_items = $block->getReviewsCollection()->getItems();
$format = $block->getDateFormat() ?: \IntlDateFormatter::SHORT;
?>
<?php if (count($_items)): ?>
    <div class="folix-review-list" id="customer-reviews">
        <?php if (!$block->getHideTitle()): ?>
            <div class="folix-review-list-title">
                <strong><?= $escaper->escapeHtml(__('Reviews')) ?></strong>
                <span class="review-count">(<?= count($_items) ?>)</span>
            </div>
        <?php endif ?>

        <div class="folix-review-list-content">
            <?php foreach ($_items as $_review): ?>
                <div class="folix-review-item" itemscope itemprop="review" itemtype="http://schema.org/Review">
                    <!-- 左侧：用户信息 + 评论内容 -->
                    <div class="folix-review-main">
                        <!-- 用户信息行 -->
                        <div class="folix-review-header">
                            <span class="folix-review-author" itemprop="author">
                                <?= $escaper->escapeHtml($_review->getNickname()) ?>
                            </span>
                            <time class="folix-review-date" itemprop="datePublished"
                                  datetime="<?= $escaper->escapeHtmlAttr($block->formatDate($_review->getCreatedAt(), $format)) ?>">
                                <?= $escaper->escapeHtml($block->formatDate($_review->getCreatedAt(), $format)) ?>
                            </time>
                        </div>

                        <!-- 评论内容 -->
                        <div class="folix-review-content" itemprop="description">
                            <?= /* @noEscape */ nl2br($escaper->escapeHtml($_review->getDetail())) ?>
                        </div>
                    </div>

                    <!-- 右侧：星级评分 -->
                    <?php if (count($_review->getRatingVotes())): ?>
                        <div class="folix-review-rating">
                            <?php
                            // 计算平均星级
                            $totalPercent = 0;
                            $voteCount = 0;
                            foreach ($_review->getRatingVotes() as $_vote) {
                                $totalPercent += $_vote->getPercent();
                                $voteCount++;
                            }
                            $avgPercent = $voteCount > 0 ? $totalPercent / $voteCount : 0;
                            $starRating = round($avgPercent / 20, 1); // 转换为 1-5 星
                            $fullStars = floor($starRating);
                            $halfStar = ($starRating - $fullStars) >= 0.5 ? 1 : 0;
                            $emptyStars = 5 - $fullStars - $halfStar;
                            ?>
                            <div class="folix-stars" title="<?= $escaper->escapeHtmlAttr($starRating . ' / 5') ?>">
                                <?php for ($i = 0; $i < $fullStars; $i++): ?>
                                    <span class="folix-star folix-star-full">★</span>
                                <?php endfor; ?>
                                <?php if ($halfStar): ?>
                                    <span class="folix-star folix-star-half">★</span>
                                <?php endif; ?>
                                <?php for ($i = 0; $i < $emptyStars; $i++): ?>
                                    <span class="folix-star folix-star-empty">★</span>
                                <?php endfor; ?>
                            </div>
                        </div>
                    <?php endif; ?>
                </div>
            <?php endforeach; ?>
        </div>

        <?php if ($block->getPagerHtml()): ?>
            <div class="folix-review-toolbar">
                <?= $block->getPagerHtml() ?>
            </div>
        <?php endif; ?>
    </div>
<?php endif; ?>
