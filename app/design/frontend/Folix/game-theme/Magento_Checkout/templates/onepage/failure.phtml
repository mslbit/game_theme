        </div>

        <?php if ($block->getRealOrderId()) : ?>
            <div class="order-info">
                <div class="order-info-row">
                    <span class="order-info-label"><?= $escaper->escapeHtml(__('Order Number')) ?></span>
                    <span class="order-info-value order-number">#<?= $escaper->escapeHtml($block->getRealOrderId()) ?></span>
                </div>
            </div>
        <?php endif; ?>

        <?php if ($error = $block->getErrorMessage()) : ?>
            <div class="failure-reason">
                <div class="failure-reason-icon">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                    </svg>
                </div>
                <div class="failure-reason-text"><?= $escaper->escapeHtml($error) ?></div>
            </div>
        <?php endif; ?>

        <div class="failure-actions">
            <a href="<?= $escaper->escapeUrl($block->getUrl('checkout/cart')) ?>" class="action primary retry-btn">
                <?= $escaper->escapeHtml(__('Try Again')) ?>
            </a>
            <a href="<?= $escaper->escapeUrl($block->getUrl('help-center')) ?>" class="action secondary support-btn">
                <?= $escaper->escapeHtml(__('Contact Support')) ?>
            </a>
        </div>
    </div>
</div>

