<?xml version="1.0"?>
<!--
/**
 * Folix Game Theme - Default Layout
 * 
 * 头部结构（严格按原型）：
 * 
 * Top Bar (header.panel) - 深蓝渐变背景，高度40px
 * ├── 左侧：新闻、奖励、支持链接
 * └── 右侧：APP下载、语言切换
 * 
 * Main Bar (header.content) - 白色背景，高度70px，底部橙色边框3px
 * ├── Logo
 * ├── 导航菜单
 * ├── 搜索框
 * └── 登录按钮
 * 
 * 注意：跑马灯不在header内，可能在page.top区域
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- =================================================================
             TOP BAR - 顶部栏
             深蓝渐变背景，高度40px
             左侧：链接 | 右侧：APP + 语言切换
             ================================================================= -->
        
        <referenceContainer name="header.panel">
            <!-- 左侧链接容器 -->
            <container name="folix.top.left" label="Folix Top Left Links" htmlTag="div" htmlClass="header-links-left" before="-" />
            
            <!-- 中间容器（跑马灯或留空） -->
            <container name="folix.top.center" label="Folix Top Center" htmlTag="div" htmlClass="header-links-center" after="folix.top.left" />
            
            <!-- 右侧容器 -->
            <container name="folix.top.right" label="Folix Top Right" htmlTag="div" htmlClass="header-links-right" after="folix.top.center"  />
        </referenceContainer>
        
        <!-- 移除不需要的原生元素 -->
        <!-- 注意：不要移除 header.links，它在移动端会显示在 Account 标签页中 -->
        <referenceBlock name="skip_to_content" remove="true" />
        <referenceBlock name="catalog.compare.link" remove="true" />
        <referenceBlock name="top.search"  remove="true" />   
        
        <!-- 移动语言切换到右侧容器 -->
        <move element="store_language" destination="folix.top.right" />
        
        <!-- 左侧链接内容 -->
        <referenceContainer name="folix.top.left" >
            <block class="Magento\Framework\View\Element\Template" name="folix.top.links" template="Magento_Theme::html/header/links-top-left.phtml" before="-" >
               <block class="Magento\Cms\Block\Block" name="folix.moblie.account" as="folix.account">
                    <arguments>
                        <argument name="block_id" xsi:type="string">header-left-content</argument>
                    </arguments>
                </block>
            </block>
        </referenceContainer>
     
       <referenceContainer name="header-wrapper">
             <container name="folix.header.nav"  htmlTag="div" htmlClass="folix-nav-container" />
         </referenceContainer>
         <referenceBlock  name="store.settings" remove="true" />

         <referenceBlock name="navigation.sections" >
            
                <block class="Magento\Framework\View\Element\Template" name="folix.top.search" as="topSearch"  template="Magento_Search::form.mini.phtml">
                <arguments>
                    <argument name="configProvider" xsi:type="object">Magento\Search\ViewModel\ConfigProvider</argument>
                    <argument name="additionalSearchFormData" xsi:type="object">Magento\Search\ViewModel\AdditionalSearchFormData</argument>
                </arguments>
            </block>
             <!--mobile account-->
            <referenceBlock class="Magento\Customer\Block\Account\Customer" name="store.links" group="navigation-sections" template="Magento_Customer::account/mobile-account-container.phtml">
                <block class="Magento\Customer\Block\Account\AuthorizationLink" name="authorization-link-mobile"
                   template="Magento_Customer::account/link/mobile-authorization.phtml"/>
            </referenceBlock> 
            
         </referenceBlock>
         
 
         <!-- Banner 骨架占位内联样式：HTML 到达即显示，不等 merged CSS（注意：此 block 必须保持可缓存，勿加 cacheable="false"） -->
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template" name="folix.banner.skeleton" template="Magento_Theme::html/banner-skeleton.phtml"/>
        </referenceBlock>

        <move element="navigation.sections" destination="folix.header.nav" />
           
       
        <move element="logo" destination="folix.header.nav" before="-" />
             <!-- Body Class -->
        <move element="minicart"  destination="folix.header.nav" after="-" />

        <referenceBlock name="footer_links">
           <referenceBlock name="search-term-popular-link" remove="true" />
           <referenceBlock name="sales-guest-form-link" remove="true" />
           <referenceBlock name="catalog-search-advanced-link" remove="true" />
           
        </referenceBlock>

        <referenceContainer name="footer-container">
            <block class="Magento\Framework\View\Element\Template" name="folix.footer.top" template="Magento_Theme::html/footer-top.phtml" before="-" />
        </referenceContainer>

        <referenceContainer name="footer">
        <block class="Magento\Framework\View\Element\Template" name="folix.footer.left" template="Magento_Theme::html/footer-left.phtml" before="-">
                <block name="left-links-footer" class="Magento\Cms\Block\BlockByIdentifier" after="-" >
                    <arguments>
                        <argument name="identifier" xsi:type="string">footer-left-content</argument>
                    </arguments>
            </block>
        </block>
        <block class="Magento\Framework\View\Element\Template" name="folix.footer.middle" template="Magento_Theme::html/footer-middle.phtml" after="-">
                <block name="middle-links-footer" class="Magento\Cms\Block\BlockByIdentifier" >
                <arguments>
                    <argument name="identifier" xsi:type="string">footer-middle-content</argument>
                </arguments>
              </block>
        </block>
              <block class="Magento\Framework\View\Element\Template" name="folix.footer.right" template="Magento_Theme::html/footer-right.phtml" after="-">
                  <block name="right-links-footer" class="Magento\Cms\Block\BlockByIdentifier" >
                    <arguments>
                        <argument name="identifier" xsi:type="string">footer-right-content</argument>
                    </arguments>
                 </block>
            </block>
        </referenceContainer>
        <move element="footer_links" destination="folix.footer.left" before="left-links-footer" />
        <move element="form.subscribe" destination="folix.footer.right" after="-" />
          <!-- Body Class -->
        <attribute name="body" value="folix-theme" />
        
    </body>
</page>