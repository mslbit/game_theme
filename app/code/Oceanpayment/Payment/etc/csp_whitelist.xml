<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="oceanpayment-script" type="host">*.oceanpayment.com</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="oceanpayment-frame" type="host">*.oceanpayment.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="oceanpayment-connect" type="host">*.oceanpayment.com</value>
            </values>
        </policy>
        <policy id="form-action">
            <values>
                <value id="oceanpayment-form" type="host">*.oceanpayment.com</value>
            </values>
        </policy>
        <policy id="style-src">
            <values>
                <value id="oceanpayment-style" type="host">*.oceanpayment.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="oceanpayment-img" type="host">*.oceanpayment.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
