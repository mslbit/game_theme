<?xml version="1.0"?>
<!--
/**
 * Oceanpayment Payment Module - Web API Routes
 *
 * 路由前缀：/V1/oceanpayment/
 * - POST /V1/oceanpayment/notice - 异步通知回调
 * - GET  /V1/oceanpayment/:quoteId/place-pay - 获取 pay_url
 * - POST /V1/oceanpayment/:quoteId/:methodCode/checkout-data - 获取嵌入式 checkout 数据
 */
-->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">

    <!-- Oceanpayment 异步通知回调 -->
    <route url="/V1/oceanpayment/notice" method="POST">
        <service class="Oceanpayment\Payment\Api\NotificationInterface" method="handle"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <!-- Oceanpayment 获取 pay_url（3D验证跳转地址，使用 quoteId 避免暴露 orderId） -->
    <route url="/V1/oceanpayment/:quoteId/place-pay" method="GET">
        <service class="Oceanpayment\Payment\Api\PlacePayInterface" method="getPay"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <!-- Oceanpayment 嵌入式支付 checkout 数据（后端组装敏感字段，前端直接传给 SDK） -->
    <route url="/V1/oceanpayment/:quoteId/:methodCode/checkout-data" method="POST">
        <service class="Oceanpayment\Payment\Api\CheckoutDataInterface" method="getCheckoutData"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

</routes>
