<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">

    <route url="/V1/oceanpayment/notice" method="POST">
        <service class="Oceanpayment\Payment\Api\NotificationInterface" method="handle"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <route url="/V1/oceanpayment/pre-order" method="POST">
        <service class="Oceanpayment\Payment\Api\PreOrderInterface" method="preOrder"/>
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="cartId" force="true">%cart_id%</parameter>
        </data>
    </route>

    <route url="/V1/guest-oceanpayment/:cartId/pre-order" method="POST">
        <service class="Oceanpayment\Payment\Api\PreOrderInterface" method="guestPreOrder"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <route url="/V1/oceanpayment/place-pay" method="POST">
        <service class="Oceanpayment\Payment\Api\PlacePayInterface" method="placePay"/>
        <resources>
            <resource ref="self"/>
        </resources>
        <data>
            <parameter name="cartId" force="true">%cart_id%</parameter>
        </data>
    </route>

    <route url="/V1/guest-oceanpayment/:cartId/place-pay" method="POST">
        <service class="Oceanpayment\Payment\Api\PlacePayInterface" method="guestPlacePay"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>


</routes>