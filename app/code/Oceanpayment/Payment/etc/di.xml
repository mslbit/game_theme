<?xml version="1.0"?>
<!--
/**
 * Oceanpayment Payment Module - DI Configuration
 *
     * 嵌入式支付（CC/ApplePay/GooglePay）通过不同的 Command 组合：
     * - authorize=NullCommand（前端 SDK.checkout() 提交网关，authorize 阶段无需后端操作）
     * - capture=NullCommand（回调/通知确认后由 PaymentSuccessService 处理，无需 Command Pool capture）
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- ========================================================================
         Section 1: Logger
         ======================================================================== -->
    <virtualType name="OPLogger" type="Magento\Payment\Model\Method\Logger">
        <arguments>
            <argument name="logger" xsi:type="object">Psr\Log\LoggerInterface</argument>
        </arguments>
    </virtualType>

    <!-- ========================================================================
         Section 2: Config - 每种支付方式独立的配置虚拟类型
         ======================================================================== -->
    <virtualType name="OPCreditCardConfig" type="Oceanpayment\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Oceanpayment\Payment\Model\Ui\ConfigProvider::CODE_CREDITCARD</argument>
        </arguments>
    </virtualType>
    <virtualType name="OPApplePayConfig" type="Oceanpayment\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Oceanpayment\Payment\Model\Ui\ConfigProvider::CODE_APPLEPAY</argument>
        </arguments>
    </virtualType>
    <virtualType name="OPGooglePayConfig" type="Oceanpayment\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Oceanpayment\Payment\Model\Ui\ConfigProvider::CODE_GOOGLEPAY</argument>
        </arguments>
    </virtualType>

    <!-- ========================================================================
         Section 3: Value Handler Pool
         ======================================================================== -->
    <virtualType name="OPCreditCardValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">OPCreditCardConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="OPCreditCardConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">OPCreditCardConfig</argument>
        </arguments>
    </virtualType>

    <virtualType name="OPApplePayValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">OPApplePayConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="OPApplePayConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">OPApplePayConfig</argument>
        </arguments>
    </virtualType>

    <virtualType name="OPGooglePayValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">OPGooglePayConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="OPGooglePayConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">OPGooglePayConfig</argument>
        </arguments>
    </virtualType>

    <!-- ========================================================================
         Section 4: Validator Pool
         ======================================================================== -->
    <virtualType name="OPCreditCardValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">OPCreditCardCountryValidator</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="OPApplePayValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">OPApplePayCountryValidator</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="OPGooglePayValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">OPGooglePayCountryValidator</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="OPCreditCardCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">OPCreditCardConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="OPApplePayCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">OPApplePayConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="OPGooglePayCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">OPGooglePayConfig</argument>
        </arguments>
    </virtualType>

    <!-- ========================================================================
         Section 5: EmbeddedCapture Command - 嵌入式 capture 命令
         查询网关订单状态 + 金额校验，不成功则标记审查
         ======================================================================== -->

    <!-- 订单查询请求构建器 -->
    <virtualType name="OPEmbeddedCaptureRequest" type="Oceanpayment\Payment\Gateway\Request\Builder\OrderQueryBuilder">
        <arguments>
            <argument name="config" xsi:type="object">Oceanpayment\Payment\Gateway\Config\Config</argument>
            <argument name="signatureHelper" xsi:type="object">Oceanpayment\Payment\Gateway\Helper\SignatureHelper</argument>
        </arguments>
    </virtualType>

    <!-- 嵌入式 capture 命令：查询网关确认支付结果 -->
    <virtualType name="OPEmbeddedCaptureCommand" type="Oceanpayment\Payment\Gateway\Command\EmbeddedCaptureCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">OPEmbeddedCaptureRequest</argument>
            <argument name="transferFactory" xsi:type="object">Oceanpayment\Payment\Gateway\Http\OrderQueryTransferFactory</argument>
            <argument name="client" xsi:type="object">Oceanpayment\Payment\Gateway\Http\Client</argument>
        </arguments>
    </virtualType>

    <!-- ========================================================================
         Section 6: Command Pool - 每种支付方式的命令池
         嵌入式（CC/ApplePay/GooglePay）: authorize=NullCommand, capture=NullCommand
         ======================================================================== -->

    <!-- Credit Card 命令池（嵌入式） -->
    <virtualType name="OPCreditCardCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="authorize" xsi:type="string">OPEmbeddedCaptureCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Apple Pay 命令池（嵌入式） -->
    <virtualType name="OPApplePayCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="authorize" xsi:type="string">OPEmbeddedCaptureCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Google Pay 命令池（嵌入式） -->
    <virtualType name="OPGooglePayCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="authorize" xsi:type="string">OPEmbeddedCaptureCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- ========================================================================
         Section 7: Payment Facade
         ======================================================================== -->
    <virtualType name="OPCreditCardFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">Oceanpayment\Payment\Model\Ui\ConfigProvider::CODE_CREDITCARD</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Oceanpayment\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">OPCreditCardValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">OPCreditCardValidatorPool</argument>
            <argument name="commandPool" xsi:type="object">OPCreditCardCommandPool</argument>
        </arguments>
    </virtualType>

    <virtualType name="OPApplePayFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">Oceanpayment\Payment\Model\Ui\ConfigProvider::CODE_APPLEPAY</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Oceanpayment\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">OPApplePayValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">OPApplePayValidatorPool</argument>
            <argument name="commandPool" xsi:type="object">OPApplePayCommandPool</argument>
        </arguments>
    </virtualType>

    <virtualType name="OPGooglePayFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">Oceanpayment\Payment\Model\Ui\ConfigProvider::CODE_GOOGLEPAY</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Oceanpayment\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">OPGooglePayValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">OPGooglePayValidatorPool</argument>
            <argument name="commandPool" xsi:type="object">OPGooglePayCommandPool</argument>
        </arguments>
    </virtualType>

    <!-- ========================================================================
         Section 8: AuthorizeCommand 已移除
         原全局替换 AuthorizeOperation 的 stateCommand 改为事件观察者方式：
         PaymentPlaceEndObserver 监听 sales_order_payment_place_end
         ======================================================================== -->

    <!-- ========================================================================
         Section 9: ConfigProvider 注入配置（仅嵌入式3种）
         ======================================================================== -->
    <type name="Oceanpayment\Payment\Model\Ui\ConfigProvider">
        <arguments>
            <argument name="creditCardConfig" xsi:type="object">OPCreditCardConfig</argument>
            <argument name="applePayConfig" xsi:type="object">OPApplePayConfig</argument>
            <argument name="googlePayConfig" xsi:type="object">OPGooglePayConfig</argument>
        </arguments>
    </type>

    <!-- ========================================================================
         Section 10: Web API 接口绑定
         ======================================================================== -->
    <preference for="Oceanpayment\Payment\Api\NotificationInterface"
                type="Oceanpayment\Payment\Model\Notification" />

    <preference for="Oceanpayment\Payment\Api\PlacePayInterface"
                type="Oceanpayment\Payment\Model\PlacePay" />

    <preference for="Oceanpayment\Payment\Api\CheckoutDataInterface"
                type="Oceanpayment\Payment\Model\CheckoutData" />

</config>
