<?xml version="1.0"?>
<!--
/**
 * Oceanpayment Payment Module - Default Configuration
 *
 * 嵌入式支付（CC/ApplePay/GooglePay）：payment_action=authorize
 * authorize 阶段由 NullCommand 跳过，回调/通知确认后由 PaymentSuccessService 处理
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>

        <payment>
            <!-- Oceanpayment 通用网关配置（oceanpayment_payment 配置段） -->
            <oceanpayment_payment>
                <environment>sandbox</environment>
                <debug>0</debug>
                <sandbox_account/>
                <production_account/>
                <sandbox_gateway_url>https://test-secure.oceanpayment.com</sandbox_gateway_url>
                <production_gateway_url>https://secure.oceanpayment.com</production_gateway_url>
                <notification_ip_whitelist/>
                <notification_ip_allow_all>1</notification_ip_allow_all>
            </oceanpayment_payment>

            <!-- Credit Card（嵌入式） -->
            <oceanpayment_creditcard>
                <model>OPCreditCardFacade</model>
                <group>oceanpayment</group>
                <title>Credit Card</title>
                <is_gateway>1</is_gateway>
                <can_use_checkout>1</can_use_checkout>
                <can_use_internal>0</can_use_internal>
                <can_authorize>1</can_authorize>
                <can_capture>1</can_capture>
                <can_void>1</can_void>
                <can_refund>0</can_refund>
                <can_sale>0</can_sale>
                <can_initialize>0</can_initialize>
                <active>0</active>
                <order_status>pending_payment</order_status>
                <payment_action>authorize</payment_action>
                <allowspecific>0</allowspecific>
                <specificcountry/>
                <sort_order>10</sort_order>
                <methods>Credit Card</methods>
                <sandbox_terminal/>
                <production_terminal/>
                <sandbox_securecode backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <production_securecode backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <public_key/>
            </oceanpayment_creditcard>

            <!-- Apple Pay（嵌入式） -->
            <oceanpayment_applepay>
                <model>OPApplePayFacade</model>
                <group>oceanpayment</group>
                <title>Apple Pay</title>
                <is_gateway>1</is_gateway>
                <can_use_checkout>1</can_use_checkout>
                <can_use_internal>0</can_use_internal>
                <can_authorize>1</can_authorize>
                <can_capture>1</can_capture>
                <can_void>1</can_void>
                <can_refund>0</can_refund>
                <can_sale>0</can_sale>
                <can_initialize>0</can_initialize>
                <active>0</active>
                <order_status>pending_payment</order_status>
                <payment_action>authorize</payment_action>
                <allowspecific>0</allowspecific>
                <specificcountry/>
                <sort_order>20</sort_order>
                <methods>ApplePay</methods>
                <production_terminal/>
                <production_securecode backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
            </oceanpayment_applepay>

            <!-- Google Pay（嵌入式） -->
            <oceanpayment_googlepay>
                <model>OPGooglePayFacade</model>
                <group>oceanpayment</group>
                <title>Google Pay</title>
                <is_gateway>1</is_gateway>
                <can_use_checkout>1</can_use_checkout>
                <can_use_internal>0</can_use_internal>
                <can_authorize>1</can_authorize>
                <can_capture>1</can_capture>
                <can_void>1</can_void>
                <can_refund>0</can_refund>
                <can_sale>0</can_sale>
                <can_initialize>0</can_initialize>
                <active>0</active>
                <order_status>pending_payment</order_status>
                <payment_action>authorize</payment_action>
                <allowspecific>0</allowspecific>
                <specificcountry/>
                <sort_order>30</sort_order>
                <methods>GooglePay</methods>
                <production_terminal/>
                <production_securecode backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>

            </oceanpayment_googlepay>

        </payment>

    </default>
</config>
