<?xml version="1.0"?>
<!--
/**
 * Oceanpayment Payment Module - Frontend DI Configuration
 *
 * 注册 ConfigProvider 到 Magento Checkout 的复合配置提供器中，
 * 使 Oceanpayment 各支付方式的配置信息（标题、Logo、启用状态等）
 * 可以在 Checkout JS 组件中动态获取
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\Model\CompositeConfigProvider">
        <arguments>
            <argument name="configProviders" xsi:type="array">
                <item name="oceanpayment_config_provider" xsi:type="object">Oceanpayment\Payment\Model\Ui\ConfigProvider</item>
            </argument>
        </arguments>
    </type>
</config>