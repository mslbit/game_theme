<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment">
            <group id="oceanpayment" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Oceanpayment</label>
                <comment>Accept credit cards, Apple Pay, Google Pay, WeChat Pay and Alipay via Oceanpayment hosted checkout.</comment>
                <fieldset_css>complex oceanpayment-section</fieldset_css>
                <attribute type="activity_path">payment/oceanpayment_creditcard/active</attribute>

                <group id="oceanpayment_required" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Oceanpayment Credentials</label>
                    <attribute type="expanded">1</attribute>
                    <frontend_model>Magento\Config\Block\System\Config\Form\Fieldset</frontend_model>

                    <field id="environment" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Environment</label>
                        <source_model>Oceanpayment\Payment\Model\Config\Source\Environment</source_model>
                        <config_path>payment/oceanpayment_payment/environment</config_path>
                        <comment>Select Sandbox for testing, Production for live transactions.</comment>
                    </field>

                    <field id="mode" translate="label comment" type="select" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Checkout Mode</label>
                        <source_model>Oceanpayment\Payment\Model\Config\Source\Mode</source_model>
                        <config_path>payment/oceanpayment_payment/mode</config_path>
                        <comment>Merchant Controlled: server calls sendTrade API, frontend controls redirect. Auto Redirect: server calls /pay endpoint after order placed, full page redirect.</comment>
                    </field>

                    <field id="debug" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Debug</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <config_path>payment/oceanpayment_payment/debug</config_path>
                        <comment>Enable to log request/response data for troubleshooting.</comment>
                    </field>

                    <field id="sandbox_account" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Sandbox Account</label>
                        <config_path>payment/oceanpayment_payment/sandbox_account</config_path>
                        <depends>
                            <field id="environment">sandbox</field>
                        </depends>
                    </field>
                    <field id="sandbox_terminal" translate="label" type="text" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Sandbox Terminal</label>
                        <config_path>payment/oceanpayment_payment/sandbox_terminal</config_path>
                        <depends>
                            <field id="environment">sandbox</field>
                        </depends>
                    </field>
                    <field id="sandbox_securecode" translate="label" type="obscure" sortOrder="120" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Sandbox Secure Code</label>
                        <config_path>payment/oceanpayment_payment/sandbox_securecode</config_path>
                        <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                        <depends>
                            <field id="environment">sandbox</field>
                        </depends>
                    </field>
                

                    <field id="production_account" translate="label" type="text" sortOrder="200" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Production Account</label>
                        <config_path>payment/oceanpayment_payment/production_account</config_path>
                        <depends>
                            <field id="environment">production</field>
                        </depends>
                    </field>
                    <field id="production_terminal" translate="label" type="text" sortOrder="210" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Production Terminal</label>
                        <config_path>payment/oceanpayment_payment/production_terminal</config_path>
                        <depends>
                            <field id="environment">production</field>
                        </depends>
                    </field>
                    <field id="production_securecode" translate="label" type="obscure" sortOrder="220" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Production Secure Code</label>
                        <config_path>payment/oceanpayment_payment/production_securecode</config_path>
                        <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                        <depends>
                            <field id="environment">production</field>
                        </depends>
                    </field>
                </group>

                <group id="oceanpayment_creditcard" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Credit Card</label>
                    <frontend_model>Magento\Config\Block\System\Config\Form\Fieldset</frontend_model>

                    <field id="active" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Enabled</label>
                        <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                        <config_path>payment/oceanpayment_creditcard/active</config_path>
                    </field>
                    <field id="title" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                        <label>Title</label>
                        <config_path>payment/oceanpayment_creditcard/title</config_path>
                    </field>
                    <field id="sort_order" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Sort Order</label>
                        <config_path>payment/oceanpayment_creditcard/sort_order</config_path>
                        <frontend_class>validate-number</frontend_class>
                    </field>
                    <field id="allowspecific" translate="label" type="allowspecific" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Payment from Applicable Countries</label>
                        <source_model>Magento\Payment\Model\Config\Source\Allspecificcountries</source_model>
                        <config_path>payment/oceanpayment_creditcard/allowspecific</config_path>
                    </field>
                    <field id="specificcountry" translate="label" type="multiselect" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Payment from Specific Countries</label>
                        <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                        <can_be_empty>1</can_be_empty>
                        <config_path>payment/oceanpayment_creditcard/specificcountry</config_path>
                    </field>
                    <field id="public_key" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="0">
                        <label>Public Key</label>
                        <config_path>payment/oceanpayment_creditcard/public_key</config_path>
                        <comment>Oceanpayment public key for embedded credit card iframe initialization.</comment>
                    </field>
                </group>

