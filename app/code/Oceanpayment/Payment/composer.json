{
    "name": "oceanpayment/module-payment",
    "description": "Oceanpayment payment integration for Magento 2 - Credit Card, Apple Pay, Google Pay, WeChat Pay, Alipay",
    "type": "magento2-module",
    "version": "3.0.0",
    "license": "MIT",
    "keywords": [
        "magento2",
        "oceanpayment",
        "payment",
        "credit-card",
        "apple-pay",
        "google-pay",
        "wechat-pay",
        "alipay"
    ],
    "authors": [
        {
            "name": "Oceanpayment",
            "email": "techservice@oceanpayment.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "magento/framework": "^102.0 || ^103.0",
        "magento/module-payment": "^100.2 || ^101.0",
        "magento/module-checkout": "^100.2 || ^101.0",
        "magento/module-sales": "^102.0 || ^103.0",
        "magento/module-catalog": "^103.0 || ^104.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Oceanpayment\\Payment\\": ""
        }
    }
}