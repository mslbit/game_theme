<?xml version="1.0"?>
<!--
/**
 * Folix_ProductSales - 产品成交量表
 *
 * display_volume: 成交量（导入设置 + 订单自动累加）
 */
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="folix_product_sales" resource="default" engine="innodb" comment="Folix Product Sales Volume">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" comment="Product ID"/>
        <column xsi:type="int" name="display_volume" unsigned="true" nullable="false" default="0" comment="Display Volume"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="FOLIX_PRODUCT_SALES_PRODUCT_ID_UNIQUE">
            <column name="product_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="FOLIX_PRODUCT_SALES_PRODUCT_ID_FK"
                    table="folix_product_sales" column="product_id"
                    referenceTable="catalog_product_entity" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
    </table>
</schema>
