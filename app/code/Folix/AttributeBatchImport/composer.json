{
    "name": "folix/module-attr-batch",
    "description": "Batch import product attribute options via textarea on the attribute edit page.",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": [
        "magento2",
        "magento",
        "attribute",
        "batch-import",
        "options",
        "swatches"
    ],
    "authors": [
        {
            "name": "Folix",
            "email": "dev@mslbit.com"
        }
    ],
    "support": {
        "issues": "https://github.com/mslbit/module-attr-batch/issues",
        "source": "https://github.com/mslbit/module-attr-batch"
    },
    "require": {
        "php": ">=8.1",
        "magento/framework": "^102.0 || ^103.0",
        "magento/module-catalog": "^103.0 || ^104.0",
        "magento/module-eav": "^102.0 || ^103.0",
        "magento/module-swatches": "^102.0 || ^103.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Folix\\AttributeBatchImport\\": ""
        }
    }
}
