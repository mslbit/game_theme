        <strong><?= $block->escapeHtml(__('Transaction ID')) ?>:</strong>
        <?= $block->escapeHtml($block->getInfo()->getAdditionalInformation('lianlian_transaction_id')) ?>
    </dd>
    <?php endif; ?>
    <?php if ($block->getInfo()->getAdditionalInformation('lianlian_payment_status')): ?>
    <dd class="content">
        <strong><?= $block->escapeHtml(__('Payment Status')) ?>:</strong>
        <?= $block->escapeHtml($block->getInfo()->getAdditionalInformation('lianlian_payment_status')) ?>
    </dd>
    <?php endif; ?>
</dl>