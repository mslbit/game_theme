<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">

    <!-- 连连支付异步通知回调 -->
    <route url="/V1/lianlian/notify" method="POST">
        <service class="MslPay\LianLian\Api\NotificationInterface" method="handle"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <!-- 连连支付获取 payment_url（登录用户） -->
    <route url="/V1/lianlian/:quoteId/:methodCode/pay-url" method="GET">
        <service class="MslPay\LianLian\Api\PayUrlInterface" method="getPayUrl"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>

    <!-- 连连支付获取 payment_url（访客用户） -->
    <route url="/V1/guest-lianlian/:quoteId/:methodCode/pay-url" method="GET">
        <service class="MslPay\LianLian\Api\PayUrlInterface" method="getGuestPayUrl"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

</routes>