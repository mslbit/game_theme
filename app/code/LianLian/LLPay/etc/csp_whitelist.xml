<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="devdocs-base" type="host"></value>
                <value id="lianlian-script-test" type="host">*.lianlianpay-inc.com</value>
                <value id="lianlian-script-pro" type="host">*.lianlianpay.com</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="lianlian-frame-test" type="host">*.lianlianpay-inc.com</value>
                <value id="lianlian-frame-pro" type="host">*.lianlianpay.com</value>
                <value id="lianlian-frame-local" type="host">*.ubuntu.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="devdocs" type="host"></value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
